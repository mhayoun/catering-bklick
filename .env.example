# --- Admin / moderation ---
# Comma-separated list of emails allowed to approve/reject listings at /admin.
# Defaults to joetiger05@gmail.com if left unset.
ADMIN_EMAILS=joetiger05@gmail.com

# --- Auth (Google OAuth) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Vercel KV (Redis) ---
# Create a KV database in the Vercel dashboard (Storage tab) and it will
# inject these automatically when linked to your project. For local dev,
# copy the values from Vercel > Storage > your KV DB > .env.local tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# --- Vercel Blob (photo storage) ---
# Create a Blob store in the Vercel dashboard (Storage tab); it injects
# this token automatically when linked to your project.
BLOB_READ_WRITE_TOKEN=
